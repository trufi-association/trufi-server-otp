# OTP Server Configuration
# Copy this file to .env and adjust as needed

# OTP version to use
# Available versions: 1.5.0, 2.0.0, 2.2.0, 2.4.0, 2.7.0, 2.8.1, 2.10.0
# - 1.5.0: Legacy version (Java 11)
# - 2.0.0+: Modern versions with improved performance
# - 2.8.1: Last release on Java 21
# - 2.10.0: Latest stable (recommended, Java 25)
otpversion=2.10.0
